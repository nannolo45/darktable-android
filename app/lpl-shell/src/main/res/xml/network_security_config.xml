<!-- Plain HTTP is allowed because the user types the server's address (a home-network address
     has no certificate). The web view itself only stays on that one origin; other addresses
     open in the browser. Only the system's certificate authorities are trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
