<!-- LightPhotoLibrary shell (brief P2c). One permission: network access for the web view and the
     address check. File choosing goes through the system picker (it grants access to the chosen
     files) and downloads through the system download manager, so neither needs a permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.LplShell">

        <!-- no usage statistics from the web view to its vendor (no analytics) -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <!-- singleTask: one window, one web view; the launcher, the shortcut and OPEN all reach it -->
        <activity
            android:name=".ShellActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- brief P2c item 5, PLAN.md 4.2: the darktable app opens a page of the saved server;
                 any other address is ignored and the start page shown -->
            <intent-filter>
                <action android:name="app.dtandroid.lplshell.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
    </application>
</manifest>
